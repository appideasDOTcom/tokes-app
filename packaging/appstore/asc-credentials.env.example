# App Store Connect API credentials. Copy to asc-credentials.env (git-ignored)
# and fill in. scripts/appstore.sh and scripts/appstore-certs.py load it
# automatically, so neither needs credentials passed on the command line — and
# no agent needs them pasted into a prompt.
#
# Create the key at App Store Connect -> Users and Access -> Integrations ->
# App Store Connect API -> Team Keys. Admin role is required to create
# distribution certificates. The .p8 downloads exactly once; keep it outside
# this repository.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_P8=/absolute/path/to/AuthKey_XXXXXXXXXX.p8

# Signing identities. Leave unset to auto-detect from the login keychain;
# set them only if the keychain holds more than one candidate.
#ASC_SIGN_APP="Apple Distribution: NAME (TEAMID)"
#ASC_SIGN_PKG="3rd Party Mac Developer Installer: NAME (TEAMID)"
